zephyr_include_directories("${CMAKE_CURRENT_LIST_DIR}/../src" "${LISM_ESB_FOLDER}")
target_sources(app PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../src/kb_route/behavior.c")
if(CONFIG_LISM_KB_HUB)
  target_sources(app PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../src/kb_route/hub.c" "${CMAKE_CURRENT_LIST_DIR}/../src/kb_route/trackball.c" "${CMAKE_CURRENT_LIST_DIR}/../src/kb_route/mirror_hub.c")
  set(_kb_dir "${CMAKE_CURRENT_BINARY_DIR}/kb_route")
  execute_process(COMMAND "${PYTHON_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/prepare_kb_route.py"
    "${APPLICATION_SOURCE_DIR}" "${_lism_ble_copy}" "${_lism_endpoint_copy}"
    "${CMAKE_CURRENT_BINARY_DIR}/kb_behavior.c" "${_kb_dir}" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Right hub route anchors changed")
  endif()
  foreach(name event_manager behavior pointing/input_listener behavior_queue behaviors/behavior_hold_tap combo)
    get_filename_component(original "${APPLICATION_SOURCE_DIR}/src/${name}.c" REALPATH)
    set_source_files_properties("${original}" TARGET_DIRECTORY app PROPERTIES HEADER_FILE_ONLY ON)
  endforeach()
  target_sources(app PRIVATE "${_kb_dir}/event_manager.c" "${CMAKE_CURRENT_BINARY_DIR}/kb_behavior.c" "${_kb_dir}/input_listener.c" "${_kb_dir}/behavior_queue.c" "${_kb_dir}/behavior_hold_tap.c" "${_kb_dir}/combo.c")
else()
  set(_kb_dir "${CMAKE_CURRENT_BINARY_DIR}/kb_route")
  execute_process(COMMAND "${PYTHON_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/prepare_kb_route.py" --receiver "${APPLICATION_SOURCE_DIR}" "${_kb_dir}" "${_lism_endpoint_copy}" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Receiver route idle anchors changed")
  endif()
  foreach(name behavior_queue behaviors/behavior_hold_tap combo)
    get_filename_component(original "${APPLICATION_SOURCE_DIR}/src/${name}.c" REALPATH)
    set_source_files_properties("${original}" TARGET_DIRECTORY app PROPERTIES HEADER_FILE_ONLY ON)
  endforeach()
  target_sources(app PRIVATE "${_kb_dir}/behavior_queue.c" "${_kb_dir}/behavior_hold_tap.c" "${_kb_dir}/combo.c")
  target_sources(app PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../src/kb_route/status.c" "${CMAKE_CURRENT_LIST_DIR}/../src/kb_route/icons.c" "${CMAKE_CURRENT_LIST_DIR}/../src/kb_route/mirror_display.c")
endif()
