# Never mutate the shared SDK checkout or replace MPSL's radio vectors.
function(lism_replace_once var old new)
  string(FIND "${${var}}" "${old}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Pinned SDK radio anchor moved")
  endif()
  string(REPLACE "${old}" "${new}" content "${${var}}")
  set(${var} "${content}" PARENT_SCOPE)
endfunction()
function(lism_finish_esb_sdk)
  get_property(esb_dir GLOBAL PROPERTY LISM_SDK_ESB_DIR)
  get_property(esb_copy GLOBAL PROPERTY LISM_SDK_ESB_COPY)
  get_directory_property(esb_library DIRECTORY "${esb_dir}" DEFINITION ZEPHYR_CURRENT_LIBRARY)
  set_source_files_properties("${esb_dir}/esb.c" DIRECTORY "${esb_dir}" PROPERTIES HEADER_FILE_ONLY ON)
  target_sources(${esb_library} PRIVATE "${esb_copy}")
  set_source_files_properties("${esb_dir}/esb_ppi.c" DIRECTORY "${esb_dir}" PROPERTIES HEADER_FILE_ONLY ON)
  target_sources(${esb_library} PRIVATE "${esb_copy}.ppi.c")
  target_include_directories(${esb_library} PRIVATE "${esb_dir}")
endfunction()
function(lism_prepare_esb_sdk)
  get_filename_component(nrf "${ZEPHYR_NRF_MODULE_DIR}" REALPATH)
  set(source "${nrf}/subsys/esb/esb.c")
  set(copy "${CMAKE_CURRENT_BINARY_DIR}/sdk_esb_mpsl.c")
  execute_process(COMMAND "${PYTHON_EXECUTABLE}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tools/prepare_timeslot_sdk.py"
    "${source}" "${copy}" "${nrf}/subsys/esb/esb_ppi.c" "${copy}.ppi.c" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Pinned SDK timeslot adaptation failed")
  endif()
  set_property(GLOBAL PROPERTY LISM_SDK_ESB_DIR "${nrf}/subsys/esb")
  set_property(GLOBAL PROPERTY LISM_SDK_ESB_COPY "${copy}")
  cmake_language(DEFER DIRECTORY "${APPLICATION_SOURCE_DIR}" CALL lism_finish_esb_sdk)
endfunction()
