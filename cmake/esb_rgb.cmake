if(CONFIG_RGBLED_WIDGET)
  get_filename_component(_ws "${ZEPHYR_BASE}" DIRECTORY)
  get_filename_component(_rgb "${_ws}/zmk-rgbled-widget/src/widget.c" REALPATH)
  file(READ "${_rgb}" code)
  string(PREPEND code "#include \"${CMAKE_CURRENT_LIST_DIR}/../src/esb_upstream/link.h\"\nvoid indicate_connectivity(void);\n")
  set(old "#elif IS_ENABLED(CONFIG_ZMK_SPLIT_BLE)\n    if (zmk_split_bt_peripheral_is_connected())")
  string(FIND "${code}" "${old}" match)
  if(match EQUAL -1)
    message(FATAL_ERROR "Pinned RGB peripheral connectivity hook moved")
  endif()
  string(REPLACE "${old}" "#elif IS_ENABLED(CONFIG_ZMK_SPLIT_BLE) || IS_ENABLED(CONFIG_ZMK_SPLIT_ESB)\n    if (lism_connected(CONFIG_ZMK_SPLIT_ESB_PERIPHERAL_ID))" code "${code}")
  string(REPLACE "#elif IS_ENABLED(CONFIG_ZMK_SPLIT_BLE)\n// run led_output_listener_cb" "#elif IS_ENABLED(CONFIG_ZMK_SPLIT_BLE) || IS_ENABLED(CONFIG_ZMK_SPLIT_ESB)\n// run led_output_listener_cb" code "${code}")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/rgb_esb.c" "${code}")
  set_source_files_properties("${_rgb}" TARGET_DIRECTORY app PROPERTIES HEADER_FILE_ONLY ON)
  target_sources(app PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/rgb_esb.c")
endif()
