# Left-only non-Bluetooth clock driver. The shared SDK stays read-only.
if(NOT CONFIG_SHIELD_LISM_L OR CONFIG_BT)
  message(FATAL_ERROR "HFXO handoff adaptation is only reviewed for ESB left")
endif()
get_filename_component(_left_clock_dir "${ZEPHYR_BASE}/drivers/clock_control" REALPATH)
set(_left_clock_source "${_left_clock_dir}/clock_control_nrf.c")
set(_left_clock_copy "${CMAKE_CURRENT_BINARY_DIR}/lism_left_clock_nrf.c")
execute_process(COMMAND "${PYTHON_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/prepare_left_clock_handoff.py"
  "${_left_clock_source}" "${_left_clock_copy}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Pinned left clock handoff adaptation failed")
endif()
set_property(GLOBAL PROPERTY LISM_LEFT_CLOCK_DIR "${_left_clock_dir}")
set_property(GLOBAL PROPERTY LISM_LEFT_CLOCK_COPY "${_left_clock_copy}")
function(lism_finish_left_clock_handoff)
  get_property(_left_clock_dir GLOBAL PROPERTY LISM_LEFT_CLOCK_DIR)
  get_property(_left_clock_copy GLOBAL PROPERTY LISM_LEFT_CLOCK_COPY)
  set(_left_clock_library drivers__clock_control)
  get_target_property(_left_clock_sources ${_left_clock_library} SOURCES)
  set(_left_clock_originals ${_left_clock_sources})
  list(FILTER _left_clock_originals INCLUDE REGEX "clock_control_nrf\\.c$")
  list(LENGTH _left_clock_originals _left_clock_count)
  if(NOT _left_clock_count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one original nRF clock source")
  endif()
  get_target_property(_left_clock_target_dir ${_left_clock_library} SOURCE_DIR)
  list(GET _left_clock_originals 0 _left_clock_original)
  get_filename_component(_left_clock_original "${_left_clock_original}" REALPATH BASE_DIR "${_left_clock_target_dir}")
  if(NOT _left_clock_original STREQUAL "${_left_clock_dir}/clock_control_nrf.c")
    message(FATAL_ERROR "Unexpected original nRF clock source path")
  endif()
  list(REMOVE_ITEM _left_clock_sources ${_left_clock_originals})
  set_property(TARGET ${_left_clock_library} PROPERTY SOURCES "${_left_clock_sources}")
  target_sources(${_left_clock_library} PRIVATE "${_left_clock_copy}")
  target_include_directories(${_left_clock_library} PRIVATE "${_left_clock_dir}")
endfunction()
cmake_language(DEFER DIRECTORY "${APPLICATION_SOURCE_DIR}" CALL lism_finish_left_clock_handoff)
