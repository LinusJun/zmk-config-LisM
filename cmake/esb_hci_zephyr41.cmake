function(lism_finish_hci_zephyr41)
  get_filename_component(_lism_hci_dir "${ZEPHYR_NRF_MODULE_DIR}/subsys/bluetooth/controller" REALPATH)
  get_property(_lism_hci_copy GLOBAL PROPERTY LISM_HCI41_COPY)
  get_directory_property(_lism_hci_library DIRECTORY "${_lism_hci_dir}" DEFINITION ZEPHYR_CURRENT_LIBRARY)
  set_source_files_properties("${_lism_hci_dir}/hci_driver.c" DIRECTORY "${_lism_hci_dir}" PROPERTIES HEADER_FILE_ONLY ON)
  target_sources(${_lism_hci_library} PRIVATE "${_lism_hci_copy}")
endfunction()
get_filename_component(_lism_hci_source "${ZEPHYR_NRF_MODULE_DIR}/subsys/bluetooth/controller/hci_driver.c" REALPATH)
get_filename_component(_lism_ble_source "${APPLICATION_SOURCE_DIR}/src/ble.c" REALPATH)
set(_lism_hci_copy "${CMAKE_CURRENT_BINARY_DIR}/lism_hci_zephyr41.c")
set(_lism_ble_copy "${CMAKE_CURRENT_BINARY_DIR}/lism_ble_zephyr41.c")
execute_process(COMMAND "${PYTHON_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/prepare_hci_zephyr41.py"
  "${_lism_hci_source}" "${_lism_hci_copy}" "${_lism_ble_source}" "${_lism_ble_copy}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Pinned HCI/Zephyr ABI adaptation failed")
endif()
set_source_files_properties("${_lism_ble_source}" TARGET_DIRECTORY app PROPERTIES HEADER_FILE_ONLY ON)
target_sources(app PRIVATE "${_lism_ble_copy}")
set_property(GLOBAL PROPERTY LISM_HCI41_COPY "${_lism_hci_copy}")
cmake_language(DEFER DIRECTORY "${APPLICATION_SOURCE_DIR}" CALL lism_finish_hci_zephyr41)
