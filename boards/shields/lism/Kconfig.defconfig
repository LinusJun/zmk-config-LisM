if SHIELD_LISM_L || SHIELD_LISM_R || SHIELD_LISM_DONGLE

config ZMK_KEYBOARD_NAME
    default "LisM"

config ZMK_SPLIT
    default y

config ZMK_POINTING
    default y

config ZMK_MOUSE
    default y

config INPUT
    default y

endif

if SHIELD_LISM_L || SHIELD_LISM_R

config PAW3222
    default y

config SPI
    default y

endif

if SHIELD_LISM_DONGLE

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_USB
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Two split peripherals plus the five normal host profiles.
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
