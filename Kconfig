    int "Fixed ESB RF channel (2400MHz plus channel)"
    range 2 80
    default 37
config ESB_MAX_PAYLOAD_LENGTH
    int
    default 68
config ESB_RADIO_IRQ_PRIORITY
    int
    default 0
config MPSL_TIMESLOT_SESSION_COUNT
    int
    default 1
