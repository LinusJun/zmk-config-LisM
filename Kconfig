config LISM_PROSPECTOR_LOCK_INDICATORS
    bool "Compact OPERATOR modifiers with Caps/Num Lock indicators"
    default y
    depends on PROSPECTOR_STATUS_SCREEN_OPERATOR
    depends on ZMK_HID_INDICATORS
    help
      Extends the OPERATOR modifier row with CAP and NUM host LED indicators,
      using one compact font, baseline, and spacing scheme for all six labels.

config LISM_XIAO147_TOUCH
    bool "Seeed 1.47-inch AXS5106L touchpad on LisM dongle"
    depends on SHIELD_XIAO_PLUS_147_TOUCH
    depends on INPUT && I2C
    help
      Converts AXS5106L touch motion into pointer movement and two-touch
      gestures into right click and natural-direction scrolling. USR1 toggles
      LSM6DS3 air-mouse mode and portrait/landscape display. USR2 cycles pages.

config LISM_XIAO147_DISPLAY_SELFTEST
    bool "Three-stage XIAO LCD startup diagnostic"
    depends on LISM_XIAO147_TOUCH
    default n
    help
      Before constructing OPERATOR and menus, show raw RGB565 bars, then a
      minimal LVGL screen, then the complete existing status interface.
      Does not reset settings, change key bindings or enable ADC diagnostics.

config LISM_XIAO147_RAW_CAPTURE
    bool "Opt-in AXS5106L RAW/DIFF sensor capture (not a multitouch fix)"
    depends on LISM_XIAO147_TOUCH && ZMK_USB_LOGGING && UART_LINE_CTRL
    depends on !SHELL && !CONSOLE_HANDLER && !UART_CONSOLE_MCUMGR
    default n
    help
      A separate test build only. Exact serial commands first read the L chip
      ID and firmware version, then explicitly request temporary factory-page
      sampling. No MTP upgrade, erase, calibration, sleep or GPIO reset commands
      are present. Touch/air-mouse input is isolated until bounded restoration
      verifies normal reporting. A restoration fault requires a power cycle.
      The normal firmware contains no factory-page switch or serial commands.

menuconfig LISM_RESISTIVE_JOYSTICK
    bool "LisM resistive joystick kscan driver"
    default y if DT_HAS_LINUS_RESISTIVE_JOYSTICK_ENABLED
    select ADC
    select GPIO
    select KSCAN

if LISM_RESISTIVE_JOYSTICK

config LISM_RESISTIVE_JOYSTICK_INIT_PRIORITY
    int "Initialization priority"
    default 90

config LISM_JOYSTICK_STATUS
    bool "Standard XIAO low-current charging and brief/charging-only RGB status"
    default n
    select USB_DEVICE_STACK
    help
      Only for the standard Seeed XIAO nRF52840 BQ25101 board. Select the
      approximately 50mA hardware charging setting with P0.13 high impedance.
      The charger owns charging termination; this is not battery temperature
      sensing or cell protection. Do not combine with another RGB owner.

endif
