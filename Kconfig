config LISM_SPLIT_ESB
    bool "Experimental always-ESB LisM split with BLE host coexistence"
    depends on ZMK_SPLIT && SOC_NRF52840 && BT_LL_SOFTDEVICE
    select ESB
    select ESB_DYNAMIC_INTERRUPTS
    select TINYCRYPT
    select TINYCRYPT_AES
    select TINYCRYPT_AES_CCM
    select BT_GATT_CLIENT
    help
      Keyboard positions, pointer input, battery events and central commands
      always use authenticated ESB, independent of the selected USB/BLE host.
      Encrypted BLE remains connected for enrollment and the existing set
      lifecycle. This does not yet eliminate split BLE maintenance power.
      Requires the pinned Nordic SDK, generated RADIO ownership patch and
      explicit SoftDevice Controller devicetree overlay. Opt-in test build.

if LISM_SPLIT_ESB
config LISM_SPLIT_ESB_CHANNEL
    int "Initial fixed ESB RF channel (2400 MHz plus channel)"
    range 2 80
    default 37
config ESB_MAX_PAYLOAD_LENGTH
    int
    default 68
config ESB_RADIO_IRQ_PRIORITY
    int
    default 0
config MPSL_TIMESLOT_SESSION_COUNT
    int
    default 1
endif

config LISM_BLE_INPUT_BRIDGE
    bool "Screen-managed standard BLE keyboard and mouse receiver"
    depends on LISM_BLE_HID_BRIDGE
    help
      Two independent standard HOGP input peers. Keyboard, relative mouse and
      consumer reports with connection-local on-screen pairing. Not Bluetooth
      Classic, vendor-private touch gestures or gamepad output.

config LISM_INPUT_LEGACY_COMPAT
    bool "Explicit per-device legacy BLE pairing compatibility"
    depends on LISM_BLE_INPUT_BRIDGE && LISM_TWO_KEYBOARD_SETS
    default n
    help
      Compile legacy SMP algorithms, but authorize their use only for the
      explicitly selected generic input connection. Other split, computer and
      input connections continue requiring Secure Connections. Requires the
      pinned generated Kconfig root from tools/prepare_input_security.py.

config LISM_INPUT_AUTO_PAIR
    bool "Automatic compatible pairing for selected standard BLE inputs"
    depends on LISM_INPUT_LEGACY_COMPAT
    default n
    help
      A user-selected generic BLE input may negotiate SC or legacy encrypted
      pairing without a separate compatibility toggle. Computer and LisM split
      connections retain their SC requirement. Keys retain the canonical ABI.

config LISM_BLE_HOST_PROFILES
    int "Preserved computer profile slots, independent of input bonds"
    depends on LISM_BLE_INPUT_BRIDGE
    default 6
    range 6 6

config LISM_TWO_KEYBOARD_SETS
    bool "Two registered LisM left/right sets sharing one dongle"
    depends on LISM_BLE_INPUT_BRIDGE
    help
      Keep split slots 0..3 and add left/right in 4/5. Each role uses the same
      UF2 on both sets; register each hardware Bluetooth identity once on the
      screen. Only one set is active, with an input cleanup barrier on switch.

config LISM_AUTO_SPLIT_SETS
    bool "Automatic two-set enrollment for tagged LisM halves"
    depends on LISM_TWO_KEYBOARD_SETS && LISM_INPUT_LEGACY_COMPAT
    default n
    help
      Register explicitly role-tagged, unpaired LisM halves into empty roles.
      Never replace saved roles. Conflicting candidates require manual choice.

config LISM_SPLIT_ROLE_TAG
    bool "LisM left/right discovery role tag"
    depends on ZMK_SPLIT && (!ZMK_SPLIT_ROLE_CENTRAL || LISM_STANDALONE_RIGHT)
    default y if SHIELD_LISM_L || SHIELD_LISM_R
    help
      Add a versioned role declaration to scan responses of unpaired halves.
      Already bonded peripherals retain their existing directed reconnection.

config LISM_BLE_HID_BRIDGE
    bool "Experimental BLE HID relative mouse bridge"
    depends on LISM_XIAO147_TOUCH && ZMK_SPLIT_ROLE_CENTRAL
    depends on BT_CENTRAL && BT_SMP && SETTINGS && INPUT_MODE_THREAD
    select BT_GATT_CLIENT
    help
      Explicit screen pairing for one standard BLE HOGP relative mouse.
      Bridges X/Y, buttons 1..5, Wheel and AC Pan to selected USB/BLE host.
      No classic Bluetooth, vendor protocols, keyboard/consumer keys or raw
      multitouch forwarding. Separate experimental build; saved split and host
      pairings are preserved. Only normal service discovery/security/CCCD and
      standard HID Protocol Mode writes are used.

config LISM_CHARGE_TELEMETRY
    bool "XIAO read-only power and inferred charger status telemetry"
    depends on BT && ZMK_BATTERY_REPORTING
    select GPIO
    help
      Read-only P0.17 charger monitoring for the configured XIAO nRF52840
      boards. USB battery presence is inferred from fresh voltage transitions,
      never from static voltage alone. Ambiguous USB starts remain unknown.
      Adds encrypted peripheral telemetry, not a battery protection BMS.

config LISM_PROSPECTOR_LOCK_INDICATORS
    bool "Compact OPERATOR modifiers with Caps/Num Lock indicators"
    default y
    depends on PROSPECTOR_STATUS_SCREEN_OPERATOR
    depends on ZMK_HID_INDICATORS
    help
      Extends the OPERATOR modifier row with CAP and NUM host LED indicators,
      using one compact font, baseline, and spacing scheme for all six labels.

config LISM_XIAO147_TOUCH
    bool "Seeed 1.47-inch AXS5106L touchpad on LisM dongle"
    depends on SHIELD_XIAO_PLUS_147_TOUCH
    depends on INPUT && I2C
    help
      Converts AXS5106L touch motion into pointer movement. Native two-contact
      reports, when supplied by the panel, support right click and natural
      scrolling; current tested panel firmware has only reported one contact.
      This does not enable experimental raw-profile inference. USR1 toggles
      LSM6DS3 air-mouse mode and portrait/landscape display. USR2 cycles pages.

config LISM_XIAO147_DISPLAY_SELFTEST
    bool "Three-stage XIAO LCD startup diagnostic"
    depends on LISM_XIAO147_TOUCH
    default n
    help
      Before constructing OPERATOR and menus, show raw RGB565 bars, then a
      minimal LVGL screen, then the complete existing status interface.
      Does not reset settings, change key bindings or enable ADC diagnostics.

config LISM_XIAO147_AUTO_TOUCH
    bool "Automatic AXS5106L profile touch owner"
    depends on LISM_XIAO147_TOUCH && !LISM_XIAO147_RAW_CAPTURE
    default n
    help
      Automatically enters the verified volatile DIFF interface on the status
      page after genuine release. Single-lobe pointer/left tap and separated
      two-lobe right tap/natural scroll are heuristic, not native finger count.
      No serial activation or 60-second window. Native menus, IMU and sleep
      restore normal reporting with bounded cleanup. Exact ID/FW0100/layout
      gates, fresh quiet baseline, scan watchdog and bounded error retries.
      No MTP, calibration, firmware upload or hardware reset writes.

config LISM_XIAO147_RAW_CAPTURE
    bool "Opt-in AXS5106L RAW/DIFF sensor capture (not a multitouch fix)"
    depends on LISM_XIAO147_TOUCH && ZMK_USB_LOGGING && UART_LINE_CTRL
    depends on !SHELL && !CONSOLE_HANDLER && !UART_CONSOLE_MCUMGR
    default n
    help
      A separate test build only. Exact serial commands first read the L chip
      ID and firmware version, then explicitly request temporary factory-page
      sampling. No MTP upgrade, erase, calibration, sleep or GPIO reset commands
      are present. Touch/air-mouse input is isolated until bounded restoration
      verifies normal reporting. A restoration fault requires a power cycle.
      The normal firmware contains no factory-page switch or serial commands.

config LISM_XIAO147_GESTURE_SHADOW
    bool "Experimental AXS differential profile and gesture shadow logs"
    depends on LISM_XIAO147_RAW_CAPTURE
    default n
    help
      Explicit, bounded FAST-DIFF sessions only. Uses the four captured
      stationary scenes to test spatial morphology, not general finger count.
      Requires confirmed normal-mode release before entry and a fresh quiet
      differential baseline. Logs candidate tap and natural wheel/pan only;
      SHADOW_START sends NO mouse events from inferred raw profiles.
      USR2/menu, USR1/air-mouse, disconnect, error and timeout restore normal
      reporting. Static scene replay cannot validate real taps or scrolling.

config LISM_XIAO147_RAW_GESTURE_HID_TEST
    bool "Explicit limited RAW gesture mouse-output experiment (not daily firmware)"
    depends on LISM_XIAO147_GESTURE_SHADOW
    default n
    help
      Separate experimental artifact only; normal startup and SHADOW_START
      remain unchanged. Only an explicit GESTURE_START command after fresh
      identity/version and release checks enables right-click/wheel/pan for
      one at-most60-second factory sampling session. Ordinary touch pointer
      and left-click pause during that session. No automatic entry/restart.
      Uncalibrated profiles can misclick or scroll incorrectly: use only on
      a blank test page, never for destructive/send actions or daily use.
      STOP, disconnect, page/IMU change, errors and timeout clear candidates
      and restore normal reporting. No MTP/calibration/reset writes.

menuconfig LISM_RESISTIVE_JOYSTICK
