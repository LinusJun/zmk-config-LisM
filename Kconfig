config LISM_PROSPECTOR_LOCK_INDICATORS
    bool "Compact OPERATOR modifiers with Caps/Num Lock indicators"
    default y
    depends on PROSPECTOR_STATUS_SCREEN_OPERATOR
    depends on ZMK_HID_INDICATORS
    help
      Extends the OPERATOR modifier row with CAP and NUM host LED indicators,
      using one compact font, baseline, and spacing scheme for all six labels.

config LISM_BLE_INPUT_BRIDGE
    bool "Standard BLE inputs with ESB-first admission control"
    depends on ZMK_SPLIT_ROLE_CENTRAL && ZMK_BLE
    select BT_CENTRAL
    select BT_OBSERVER
    select BT_GATT_CLIENT
    default y if SHIELD_LISM_DONGLE
config LISM_INPUT_LEGACY_COMPAT
    bool
    default y if LISM_BLE_INPUT_BRIDGE
config LISM_INPUT_AUTO_PAIR
    bool
    default y if LISM_INPUT_LEGACY_COMPAT

config LISM_KB_ROUTE
    bool "Right-hand whole-keyboard BLE/dongle output routing"
    default y
config LISM_KB_HUB
    bool "Right-hand ESB hub with five independent BLE computer slots"
    default y if SHIELD_LISM_R
    depends on ZMK_SPLIT_ROLE_CENTRAL && ZMK_BLE

config LISM_XIAO147_TOUCH
    bool "XIAO 1.47 fixed landscape touch display"
    depends on SHIELD_XIAO_PLUS_147_TOUCH && INPUT && I2C

config LISM_DONGLE_STATION
    int "Fixed dongle station (A=0, B=1)"
    range 0 1
    default 0

config LISM_XIAO147_AUTO_TOUCH
    bool "Existing guarded automatic AXS touch classifier"
    depends on LISM_XIAO147_TOUCH
    default y

config LISM_KEYBOARD_SET
    int "LisM keyboard set (Set1=0, Set2=1)"
    range 0 1
    default 0
