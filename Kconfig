config LISM_PROSPECTOR_LOCK_INDICATORS
    bool "Compact OPERATOR modifiers with Caps/Num Lock indicators"
    default y
    depends on PROSPECTOR_STATUS_SCREEN_OPERATOR
    depends on ZMK_HID_INDICATORS
    help
      Extends the OPERATOR modifier row with CAP and NUM host LED indicators,
      using one compact font, baseline, and spacing scheme for all six labels.

config LISM_XIAO147_TOUCH
    bool "Seeed 1.47-inch AXS5106L touchpad on LisM dongle"
    depends on SHIELD_XIAO_PLUS_147_TOUCH
    depends on INPUT && I2C
    help
      Converts AXS5106L touch motion into pointer movement and two-touch
      gestures into right click and natural-direction scrolling. USR1 toggles
      LSM6DS3 air-mouse mode and portrait/landscape display. USR2 cycles pages.
